# license copies staged into npm packages at publish time (canonical: /LICENSE.md)
packages/cli/*/LICENSE.md
packages/screenpipe-mcp/LICENSE.md
packages/sdk/LICENSE.md
packages/sdk/npm/*/LICENSE.md

# Test artifacts: a temp-DB path that keeps its "sqlite:" URI prefix creates a
# literal directory of that name next to the crate. Junk, but easy to commit by
# accident with `git add -A`.
sqlite:/

